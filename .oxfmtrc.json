{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "ignorePatterns": ["src/generated/**"],
  "printWidth": 80,
  "sortImports": {
    "groups": [
      "side_effect",
      ["builtin", "external"],
      "internal",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  }
}
